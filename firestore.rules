rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidMemberArray(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 10 && arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 128;
    }

    // Validation Blueprint: OrderSession
    function isValidOrderSession(data) {
      return data.keys().hasAll([
        'title',
        'storeName',
        'masterName',
        'roomCode',
        'deliveryFee',
        'status',
        'ownerId',
        'memberUids',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'storeName',
        'masterName',
        'roomCode',
        'deliveryFee',
        'status',
        'ownerId',
        'memberUids',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
      data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
      data.masterName is string && data.masterName.size() >= 1 && data.masterName.size() <= 60 &&
      data.roomCode is string && data.roomCode.size() >= 3 && data.roomCode.size() <= 20 && data.roomCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 5000 &&
      data.status is string && data.status.size() <= 20 && (data.status == 'open' || data.status == 'ordering' || data.status == 'completed') &&
      isValidId(data.ownerId) &&
      isValidMemberArray(data.memberUids) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: RoommateOrderItem
    function isValidRoommateOrderItem(data) {
      return data.keys().hasAll([
        'sessionId',
        'sessionOwnerId',
        'authorUid',
        'memberUids',
        'roommateName',
        'roomNumber',
        'itemName',
        'normalizedItemKey',
        'category',
        'quantity',
        'unitPrice',
        'paymentMethod',
        'cashPaidAmount',
        'isPaid',
        'isPurchased',
        'notes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId',
        'sessionOwnerId',
        'authorUid',
        'memberUids',
        'roommateName',
        'roomNumber',
        'itemName',
        'normalizedItemKey',
        'category',
        'quantity',
        'unitPrice',
        'paymentMethod',
        'cashPaidAmount',
        'isPaid',
        'isPurchased',
        'notes',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.sessionId) &&
      isValidId(data.sessionOwnerId) &&
      isValidId(data.authorUid) &&
      isValidMemberArray(data.memberUids) &&
      data.roommateName is string && data.roommateName.size() >= 1 && data.roommateName.size() <= 60 &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 30 &&
      data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 100 &&
      data.normalizedItemKey is string && data.normalizedItemKey.size() >= 1 && data.normalizedItemKey.size() <= 100 &&
      data.category is string && data.category.size() <= 20 && (
        data.category == 'snacks' ||
        data.category == 'meals' ||
        data.category == 'drinks' ||
        data.category == 'groceries' ||
        data.category == 'other'
      ) &&
      data.quantity is number && data.quantity >= 1 && data.quantity <= 100 &&
      data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 10000 &&
      data.paymentMethod is string && data.paymentMethod.size() <= 20 && (
        data.paymentMethod == 'cash' ||
        data.paymentMethod == 'instapay' ||
        data.paymentMethod == 'wallet'
      ) &&
      data.cashPaidAmount is number && data.cashPaidAmount >= 0 && data.cashPaidAmount <= 50000 &&
      data.isPaid is bool &&
      data.isPurchased is bool &&
      data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 160 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isParentSessionMember(sessionId) {
      let parent = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return parent.ownerId == request.auth.uid || request.auth.uid in parent.memberUids;
    }

    function isParentSessionOpen(sessionId) {
      let parent = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return parent.status != 'completed';
    }

    // Collection: /sessions/{sessionId}
    match /sessions/{sessionId} {
      allow get: if isVerified() && isValidId(sessionId) && (
        existing().ownerId == request.auth.uid || request.auth.uid in existing().memberUids
      );

      allow list: if isVerified() && (
        existing().ownerId == request.auth.uid || request.auth.uid in existing().memberUids
      );

      allow create: if isVerified() && isValidId(sessionId) &&
        isValidOrderSession(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() && isValidId(sessionId) &&
        isValidOrderSession(incoming()) &&
        existing().status != 'completed' &&
        incoming().ownerId == existing().ownerId &&
        incoming().roomCode == existing().roomCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Tier 1: Owner updates session details or status
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'storeName', 'masterName', 'deliveryFee', 'status', 'memberUids', 'updatedAt'])) ||
          // Tier 2: Roommate joins or updates member list while session is open
          (request.auth.uid in incoming().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(sessionId) && existing().ownerId == request.auth.uid;

      // Subcollection: /sessions/{sessionId}/orders/{orderId}
      match /orders/{orderId} {
        allow get: if isVerified() && isValidId(sessionId) && isValidId(orderId) && (
          existing().authorUid == request.auth.uid ||
          existing().sessionOwnerId == request.auth.uid ||
          request.auth.uid in existing().memberUids
        ) && exists(/databases/$(database)/documents/sessions/$(sessionId)) && isParentSessionMember(sessionId);

        allow list: if isVerified() && (
          existing().authorUid == request.auth.uid ||
          existing().sessionOwnerId == request.auth.uid ||
          request.auth.uid in existing().memberUids
        );

        allow create: if isVerified() && isValidId(sessionId) && isValidId(orderId) &&
          isValidRoommateOrderItem(incoming()) &&
          incoming().sessionId == sessionId &&
          incoming().authorUid == request.auth.uid &&
          request.auth.uid in incoming().memberUids &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
          isParentSessionMember(sessionId) &&
          isParentSessionOpen(sessionId) &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerId == incoming().sessionOwnerId;

        allow update: if isVerified() && isValidId(sessionId) && isValidId(orderId) &&
          isValidRoommateOrderItem(incoming()) &&
          incoming().sessionId == existing().sessionId &&
          incoming().sessionOwnerId == existing().sessionOwnerId &&
          incoming().authorUid == existing().authorUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
          isParentSessionMember(sessionId) &&
          isParentSessionOpen(sessionId) && (
            // Action 1: Author updates their order item details
            (existing().authorUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'roommateName',
                'roomNumber',
                'itemName',
                'normalizedItemKey',
                'category',
                'quantity',
                'unitPrice',
                'paymentMethod',
                'cashPaidAmount',
                'isPaid',
                'isPurchased',
                'notes',
                'updatedAt'
              ])) ||
            // Action 2: Session Master / Owner marks item purchased or paid/cash settled
            (existing().sessionOwnerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'cashPaidAmount',
                'isPaid',
                'isPurchased',
                'updatedAt'
              ]))
          );

        allow delete: if isVerified() && isValidId(sessionId) && isValidId(orderId) &&
          exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
          isParentSessionMember(sessionId) &&
          isParentSessionOpen(sessionId) && (
            existing().authorUid == request.auth.uid || existing().sessionOwnerId == request.auth.uid
          );
      }
    }
  }
}
